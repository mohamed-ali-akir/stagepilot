# Copied to .env on the server by deploy.sh the first time. Secrets (APP_KEY) are generated there, never committed.
APP_NAME=StagePilot
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://akir.alwaysdata.net
APP_TIMEZONE=Europe/Paris

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

# Only these addresses can create an account (comma-separated)
INVITED_EMAILS=aliakir679@gmail.com

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database

# Application emails (password reset): written to the log until a mailbox is configured
MAIL_MAILER=log
MAIL_FROM_ADDRESS="stagepilot@akir.alwaysdata.net"
MAIL_FROM_NAME="${APP_NAME}"

# Free hook engine, no AI
HOOK_PROVIDER=template

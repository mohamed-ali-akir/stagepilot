# Copied to .env on the server by deploy.sh the first time. Secrets (APP_KEY) are generated there, never committed.
APP_NAME=StagePilot
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://akir.alwaysdata.net
APP_TIMEZONE=Europe/Paris

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

# Only these addresses can create an account (comma-separated)
INVITED_EMAILS=aliakir679@gmail.com

LOG_CHANNEL=daily
LOG_LEVEL=warning

# MariaDB from alwaysdata since 2026-10-11 (the password is set with deploy/set_env.php, never written here)
DB_CONNECTION=mariadb
DB_HOST=mysql-akir.alwaysdata.net
DB_PORT=3306
DB_DATABASE=akir_stagepilot
DB_USERNAME=akir_stagepilot
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
# longer than the longest job (preparation with Groq waits: up to 30 min), otherwise it would be started twice
DB_QUEUE_RETRY_AFTER=1900
CACHE_STORE=database

# Application emails (password reset): written to the log until a mailbox is configured
MAIL_MAILER=log
MAIL_FROM_ADDRESS="stagepilot@akir.alwaysdata.net"
MAIL_FROM_NAME="${APP_NAME}"

# Hook engine: groq (free plan, key copied with deploy/set_env.php) or template (no AI)
HOOK_PROVIDER=groq
GROQ_API_KEY=

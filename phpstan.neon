includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    # 5 for now (the code passes it); to be raised step by step (6: missing array types, 7: union types)
    level: 5

    ignoreErrors:
        # The Anthropic SDK documents `outputConfig: ['format' => MyModel::class]` (StructuredOutputModel),
        # but its own PHPDoc type only lists raw JSON schemas: the stub is narrower than the real API.
        -
            identifier: argument.type
            path: app/Services/Hooks/ClaudeHookGenerator.php
            message: '#outputConfig#'

includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    # 7: every array, return and union type is checked (8 would also forbid nullable access)
    level: 7

    ignoreErrors:
        # The Anthropic SDK documents `outputConfig: ['format' => MyModel::class]` (StructuredOutputModel),
        # but its own PHPDoc type only lists raw JSON schemas: the stub is narrower than the real API.
        -
            identifier: argument.type
            path: app/Services/Hooks/ClaudeHookGenerator.php
            message: '#outputConfig#'
